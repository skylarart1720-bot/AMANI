# Optional local integrations. Never commit the populated .env file.
APP_ENV=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Required in production. Keep encryption keys stable and separately backed up.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ADMIN_API_TOKEN belongs to the Super Admin only.
# Create staff IDs/passwords in the dashboard's Staff accounts view.

# Internal service URLs; the local launcher assigns these automatically.
ORCHESTRATOR_URL=http://127.0.0.1:8100
URL_SAFETY_URL=http://127.0.0.1:8200
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8300
# Public business number in international digits, e.g. country code + number without spaces.
# This is not META_WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_SUPPORT_NUMBER=
AMANI_DATA_DIR=

# Meta must provision a number and a public HTTPS webhook before activation.
WHATSAPP_PROVIDER=disabled
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Set the supported Graph API version from your Meta application dashboard.
META_WHATSAPP_API_VERSION=
# Optional encrypted backup archives; distinct from CHAT_ENCRYPTION_KEY.
# Set privately before using python -m src.backup; never commit a real key.
AMANI_BACKUP_KEY=
